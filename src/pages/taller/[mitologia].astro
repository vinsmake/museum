---
// Taller de estatuas: herramienta para revisar el generador (Punto 4). Una estatua o una sala entera,
// con cámara orbital. Muestra los atributos que el catálogo no reconoce.
import { getMitologias, getSalas } from '../../lib/mitologias';

export async function getStaticPaths() {
  const activas = (await getMitologias()).filter((m) => m.data.estado === 'activa');
  return activas.map((m) => ({ params: { mitologia: m.id }, props: { mitologia: m } }));
}

const { mitologia } = Astro.props;
const salas = await getSalas(mitologia.id);
const datos = {
  piedra: mitologia.data.tema.piedra,
  salas: salas.map((s) => ({
    id: s.id,
    nombre: s.nombre,
    seres: s.seres.map((ser) => ({
      slug: ser.slug,
      nombre: ser.data.nombre,
      nombreOriginal: ser.data.nombreOriginal,
      categoria: ser.data.categoria,
      ...ser.data.estatua,
    })),
  })),
};
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Taller de estatuas · {mitologia.data.nombre}</title>
		<style>
			:root { color-scheme: dark; font-family: Georgia, serif; }
			body { margin: 0; background: #1b1916; color: #e9e4da; display: grid; grid-template-rows: auto 1fr auto; height: 100vh; }
			header, footer { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; padding: 0.6rem 1rem; background: #24211d; }
			header h1 { font-size: 1rem; margin: 0 1rem 0 0; font-weight: normal; letter-spacing: 0.08em; text-transform: uppercase; }
			select, button { font: inherit; background: #34302a; color: inherit; border: 1px solid #5a5248; padding: 0.3rem 0.6rem; }
			button:focus-visible, select:focus-visible { outline: 2px solid #b08d57; }
			#lienzo { width: 100%; height: 100%; display: block; min-height: 0; }
			#info { font-size: 0.9rem; opacity: 0.9; }
			#avisos { color: #e8a25c; font-size: 0.85rem; }
		</style>
	</head>
	<body>
		<header>
			<h1>Taller de estatuas</h1>
			<button id="anterior" type="button" aria-label="Estatua anterior">◀</button>
			<select id="selector" aria-label="Elegir ser"></select>
			<button id="siguiente" type="button" aria-label="Estatua siguiente">▶</button>
			<button id="modo" type="button">Ver sala completa</button>
			<span id="avisos"></span>
		</header>
		<canvas id="lienzo"></canvas>
		<footer><span id="info"></span></footer>

		<script type="application/json" id="datos-taller" set:html={JSON.stringify(datos)} />

		<script>
			import * as THREE from 'three';
			import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
			import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';
			import { crearEstatua, atributosDesconocidos, liberar, type DatosEstatua } from '../../estatuas';

			type Ser = DatosEstatua & { categoria: string };
			const datos = JSON.parse(document.getElementById('datos-taller')!.textContent!) as {
				piedra: string;
				salas: { id: string; nombre: string; seres: Ser[] }[];
			};
			const todos = datos.salas.flatMap((s) => s.seres.map((ser) => ({ ...ser, sala: s.id })));

			const lienzo = document.getElementById('lienzo') as HTMLCanvasElement;
			const renderer = new THREE.WebGLRenderer({ canvas: lienzo, antialias: true });
			renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
			renderer.shadowMap.enabled = true;
			renderer.shadowMap.type = THREE.PCFSoftShadowMap;
			renderer.toneMapping = THREE.ACESFilmicToneMapping;
			renderer.toneMappingExposure = 0.8;

			const escena = new THREE.Scene();
			escena.background = new THREE.Color('#2a2622');
			escena.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
			escena.environmentIntensity = 0.3;

			const sol = new THREE.DirectionalLight('#fff4e0', 1.5);
			sol.position.set(3, 6, 4);
			sol.castShadow = true;
			sol.shadow.mapSize.set(2048, 2048);
			Object.assign(sol.shadow.camera, { left: -12, right: 12, top: 6, bottom: -2, far: 30 });
			escena.add(sol, new THREE.HemisphereLight('#fff6e8', '#3a3027', 0.35));

			const suelo = new THREE.Mesh(new THREE.PlaneGeometry(80, 80), new THREE.MeshStandardMaterial({ color: '#4a433b', roughness: 0.9 }));
			suelo.rotation.x = -Math.PI / 2;
			suelo.receiveShadow = true;
			escena.add(suelo);

			const camara = new THREE.PerspectiveCamera(40, 1, 0.05, 200);
			const controles = new OrbitControls(camara, lienzo);
			controles.enableDamping = true;

			const contenido = new THREE.Group();
			escena.add(contenido);

			const selector = document.getElementById('selector') as HTMLSelectElement;
			for (const sala of datos.salas) {
				const og = document.createElement('optgroup');
				og.label = sala.nombre;
				for (const ser of sala.seres) og.append(new Option(`${ser.nombre} · ${ser.figura}`, ser.slug));
				selector.append(og);
			}

			let modoSala = false;
			const info = document.getElementById('info')!;
			const avisos = document.getElementById('avisos')!;

			function enfocar(ancho: number, alto: number) {
				const dist = Math.max(alto * 1.6, ancho * 0.9) + 1;
				camara.position.set(ancho * 0.15, alto * 0.62, dist);
				controles.target.set(0, alto * 0.5, 0);
				controles.update();
			}

			function mostrar(slug: string) {
				contenido.children.slice().forEach((h) => { liberar(h); contenido.remove(h); });
				const actual = todos.find((s) => s.slug === slug)!;
				selector.value = slug;
				const lista = modoSala ? todos.filter((s) => s.sala === actual.sala) : [actual];
				let x = 0;
				let altoMax = 0;
				const creadas = lista.map((ser) => {
					const e = crearEstatua(ser, { piedra: datos.piedra });
					const ancho = e.userData.ancho ?? 1;
					e.position.x = x + ancho / 2;
					x += ancho + 0.6;
					altoMax = Math.max(altoMax, e.userData.alto);
					return e;
				});
				creadas.forEach((e) => { e.position.x -= (x - 0.6) / 2; contenido.add(e); });
				enfocar(x, altoMax);
				const malos = [...new Set(lista.flatMap((s) => atributosDesconocidos(s.atributos)))];
				avisos.textContent = malos.length ? `Atributos sin soporte: ${malos.join(', ')}` : '';
				info.textContent = modoSala
					? `${lista.length} estatuas en esta sala`
					: `${actual.nombre} (${actual.nombreOriginal ?? ''}) · figura: ${actual.figura} · género: ${actual.genero} · escala: ${actual.escala} · atributos: ${actual.atributos.join(', ') || 'ninguno'}`;
				try { localStorage.setItem('taller:ser', slug); } catch {}
			}

			function mover(paso: number) {
				const i = todos.findIndex((s) => s.slug === selector.value);
				mostrar(todos[(i + paso + todos.length) % todos.length].slug);
			}

			selector.addEventListener('change', () => mostrar(selector.value));
			document.getElementById('anterior')!.addEventListener('click', () => mover(-1));
			document.getElementById('siguiente')!.addEventListener('click', () => mover(1));
			document.getElementById('modo')!.addEventListener('click', (ev) => {
				modoSala = !modoSala;
				(ev.target as HTMLButtonElement).textContent = modoSala ? 'Ver una estatua' : 'Ver sala completa';
				mostrar(selector.value);
			});
			addEventListener('keydown', (ev) => {
				if (ev.target instanceof HTMLSelectElement) return;
				if (ev.key === 'ArrowRight') mover(1);
				if (ev.key === 'ArrowLeft') mover(-1);
			});

			function redimensionar() {
				const { clientWidth: w, clientHeight: h } = lienzo;
				renderer.setSize(w, h, false);
				camara.aspect = w / h;
				camara.updateProjectionMatrix();
			}
			addEventListener('resize', redimensionar);
			redimensionar();

			const pedido = location.hash.slice(1);
			let inicial = todos.find((s) => s.slug === pedido)?.slug;
			if (!inicial) { try { inicial = localStorage.getItem('taller:ser') ?? undefined; } catch {} }
			mostrar(todos.find((s) => s.slug === inicial)?.slug ?? todos[0].slug);

			renderer.setAnimationLoop(() => {
				controles.update();
				renderer.render(escena, camara);
			});
		</script>
	</body>
</html>
