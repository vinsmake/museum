---
// Portada provisional (Puntos 1-2): lista las mitologías y sus seres para comprobar la carga de datos.
// Se reemplaza en el Punto 6 por el selector de mitologías.
import { getMitologias, getSalas } from '../lib/mitologias';

const mitologias = await Promise.all(
  (await getMitologias()).map(async (m) => ({ mitologia: m, salas: await getSalas(m.id) })),
);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Museo Mitológico</title>
	</head>
	<body>
		<h1>Museo Mitológico</h1>
		<p>En construcción.</p>
		{mitologias.map(({ mitologia, salas }) => (
			<section>
				<h2>{mitologia.data.nombre} ({mitologia.data.estado})</h2>
				<p>Canon: {mitologia.data.canon.obra}, {mitologia.data.canon.autor}</p>
				{salas.filter((sala) => sala.seres.length > 0).map((sala) => (
					<>
						<h3>{sala.nombre} (vv. {sala.versos})</h3>
						<ol>
							{sala.seres.map((ser) => (
								<li>
									{ser.data.nombre} ({ser.data.nombreOriginal}), v. {ser.data.aparicion.versos}
									{ser.hijos.length > 0 && <> · hijos: {ser.hijos.join(', ')}</>}
								</li>
							))}
						</ol>
					</>
				))}
			</section>
		))}
	</body>
</html>
