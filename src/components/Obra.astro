---
// Una obra enmarcada en la pared: la imagen principal del ser o, si no tiene, una ficha tipográfica
// con su nombre griego "grabado" en piedra.
import { Picture } from 'astro:assets';
import type { Ser } from '../lib/mitologias';

interface Props {
  ser: Ser;
  tamano?: 'galeria' | 'grande';
  cargaDiferida?: boolean;
}

const { ser, tamano = 'galeria', cargaDiferida = true } = Astro.props;
const img = ser.data.imagenes[0];
const anchos = tamano === 'grande' ? [480, 800, 1280] : [240, 400, 640];
const sizes = tamano === 'grande' ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 600px) 45vw, 220px';
---

<div class:list={['marco', `marco-${tamano}`, { 'sin-imagen': !img }]}>
  {
    img ? (
      <Picture
        src={img.archivo}
        alt={img.alt ?? `${img.obra} (${ser.data.nombre})`}
        widths={[...new Set([...anchos.filter((w) => w < img.archivo.width), Math.min(img.archivo.width, anchos.at(-1)!)])]}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={cargaDiferida ? 'lazy' : 'eager'}
        style={img.enfoque ? `object-position: ${img.enfoque}` : undefined}
      />
    ) : (
      <div class="placa" role="img" aria-label={`${ser.data.nombre}: sin obra conocida`}>
        <span class="placa-griego">{ser.data.nombreOriginal ?? ser.data.nombre}</span>
        <span class="placa-nota">sin obra conocida</span>
      </div>
    )
  }
</div>
